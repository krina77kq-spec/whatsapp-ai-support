    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\n\nif (!body.entry || !body.entry[0]) {\n  return [];\n}\n\nconst change = body.entry[0].changes[0];\nconst value = change.value;\n\nif (!value.messages || value.messages.length === 0) {\n  return [];\n}\n\nconst message = value.messages[0];\n\n// Tipos de mensaje que sabemos procesar como texto en esta v1\nconst tiposSoportados = ['text'];\n\nreturn [{\n  json: {\n    phone: message.from,\n    external_id: message.id,\n    message_type: message.type,\n    body: message.text ? message.text.body : null,\n    is_supported: tiposSoportados.includes(message.type),\n    timestamp: message.timestamp,\n    raw_payload: body\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -592,
        -128
      ],
      "id": "acb0d3b5-13fd-4d38-ae21-377c91a22581",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO contacts (phone, name)\nVALUES ($1, 'Cliente WhatsApp')\nON CONFLICT (phone) DO UPDATE SET name = contacts.name\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ $json.phone }}"
        }
      },
